{
  "plugins": [
    [
      "postcss-custom-media",
      {
        "importFrom": "./src/styles/media.css"
      }
    ],
    [
      "postcss-custom-properties",
      {
        "disableDeprecationNotice": true
      }
    ],
    [
      "postcss-preset-env",
      {
        "autoprefixer": {
          "flexbox": "no-2009"
        },
        "stage": 3,
        "features": {
          "custom-properties": false
        }
      }
    ]
  ]
}
